# =============================================================================
# bench.env — Benchmark configuration
#
# Edit values here. docker-compose.yml reads this file automatically.
# =============================================================================

# Payload size the mock upstream server generates per response
PAYLOAD_KB=100

# Number of unique IDs in the key pool — each ID becomes a distinct cache key.
# Higher values = more cache misses (cold keys), lower = more hits (warm cache).
# 500 gives a realistic mix: first pass warms ~500 keys, subsequent requests hit.
KEY_POOL_SIZE=500

# Simulated upstream latency (ms) and failure rate (0.0–1.0)
LATENCY_MS=50
FAILURE_RATE=0

# How long each benchmark run lasts
DURATION_SEC=30
